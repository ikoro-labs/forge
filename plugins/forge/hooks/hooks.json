{
  "description": "Forge factory guards: git and GitHub safety, the coder's role, the judges' read-only rule, the pause switch, the em dash check after a write, the trimmed output of a named command that passes, the drained session handoff at the context limit, and, at the start of a session, the other live sessions of its repository.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/sessions_notice.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "out=$(uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_git.py\" 2>&1); code=$?; [ \"$code\" -eq 0 ] && exit 0; printf '%s\n' \"$out\" >&2; case \"$out\" in \"Blocked by the forge plugin (guard_git)\"*|\"guard_git failed\"*) ;; *) echo \"guard_git failed (exit $code before the guard could rule): the command is refused as a precaution. This is not a rule of the repository; retry, and tell the human if it persists.\" >&2;; esac; exit 2",
            "onFailure": "block",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Skill|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_coder.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_pause.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/after_write.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/trim_output.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff_trigger.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff_trigger.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
