{
  "description": "Forge factory guards: git and GitHub safety, the coder's role, the judges' read-only rule, the pause switch, and the em dash check after a write.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_git.py\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_coder.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_readonly.py\" || exit 2"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_pause.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --quiet python \"${CLAUDE_PLUGIN_ROOT}/hooks/after_write.py\""
          }
        ]
      }
    ]
  }
}
