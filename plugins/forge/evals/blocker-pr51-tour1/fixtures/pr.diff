+    def test_a_command_over_its_memory_limit_fails_instead_of_passing(self) -> None:
+        """No F-NNNN: ticket #43, critère 4: la mémoire est bornée, la commande qui la dépasse échoue."""
+        repo, base, head = self.fixture()
